# GiCat — локальные и служебные файлы
exports/
.gicat/*.local.json
*.tmp
Thumbs.db
.DS_Store
~$*

# --- GiCat strict sync rules ---
# GiCat local CAT state
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
